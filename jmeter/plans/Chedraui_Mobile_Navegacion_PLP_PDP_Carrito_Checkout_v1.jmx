        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build payload - getCheckoutOrderForm" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def orderFormId = (vars.get(&apos;ORDERFORM_ID&apos;) ?: &apos;&apos;).toString().trim()
def seller = (vars.get(&apos;SELLER&apos;) ?: &apos;&apos;).toString().trim()
def geo = (vars.get(&apos;GEO_COORDS&apos;) ?: &apos;&apos;).toString().trim()

def parts = geo.split(&apos;,&apos;)*.trim()
def lon = parts.size() &gt; 0 ? Double.parseDouble(parts[0]) : -99.17599709999999d
def lat = parts.size() &gt; 1 ? Double.parseDouble(parts[1]) : 19.4281046d
vars.put(&apos;GEO_LON&apos;, String.valueOf(lon))
vars.put(&apos;GEO_LAT&apos;, String.valueOf(lat))

def payload = [
  orderFormId: orderFormId,
  geoCoordinates: [lon, lat],
  seller: seller,
]

vars.put(&apos;MOBILE_GET_CHECKOUT_ORDERFORM_JSON&apos;, JsonOutput.toJson(payload))</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /backend-app/getCheckoutOrderForm" enabled="true">
            <stringProp name="HTTPSampler.path">${MOBILE_BASE_PATH}/getCheckoutOrderForm</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${MOBILE_GET_CHECKOUT_ORDERFORM_JSON}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract orderFormId (best-effort)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
if (!body) return

def json
try { json = new JsonSlurper().parseText(body) } catch (Throwable ignored) { return }

def idRegex = ~/^[0-9a-fA-F]{32}$/
def found = null

def walk
walk = { obj -&gt;
  if (found != null) return
  if (obj instanceof Map) {
    obj.each { k, v -&gt;
      if (found != null) return
      if (k?.toString()?.equalsIgnoreCase(&apos;orderFormId&apos;) &amp;&amp; v != null) {
        def s = v.toString().trim()
        if (s ==~ idRegex || s.equalsIgnoreCase(&apos;default-order-form&apos;)) {
          found = s
          return
        }
      }
      walk(v)
    }
  } else if (obj instanceof List) {
    obj.each { walk(it) }
  }
}

walk(json)

if (found != null) {
  vars.put(&apos;orderFormId&apos;, found)
} else {
  def fallback = (vars.get(&apos;ORDERFORM_ID&apos;) ?: &apos;&apos;).toString().trim()
  if (!fallback.isEmpty()) {
    vars.put(&apos;orderFormId&apos;, fallback)
  }
}</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract SHIP_ITEM_ID (best-effort)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
if (!body) return

def json
try { json = new JsonSlurper().parseText(body) } catch (Throwable ignored) { return }

def firstItemId = null

def findItems
findItems = { obj -&gt;
  if (firstItemId != null) return
  if (obj instanceof Map) {
    obj.each { k, v -&gt;
      if (firstItemId != null) return
      if (k?.toString()?.equalsIgnoreCase(&apos;items&apos;) &amp;&amp; (v instanceof List) &amp;&amp; !v.isEmpty()) {
        def first = v[0]
        if (first instanceof Map) {
          def candidates = [&apos;id&apos;,&apos;itemId&apos;,&apos;skuId&apos;,&apos;uniqueId&apos;,&apos;productId&apos;]
          for (def c : candidates) {
            def val = first[c]
            if (val != null &amp;&amp; val.toString().trim()) {
              firstItemId = val.toString().trim()
              return
            }
          }
        }
      }
      findItems(v)
    }
  } else if (obj instanceof List) {
    obj.each { findItems(it) }
  }
}

findItems(json)

if (firstItemId != null) {
  vars.put(&apos;SHIP_ITEM_ID&apos;, firstItemId)
}</stringProp>
