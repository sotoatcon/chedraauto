        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="01 - Bootstrap OrderForm (getCheckoutOrderForm)" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">true</boolProp>
