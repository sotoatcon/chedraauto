            <stringProp name="script">
def sp = vars.get(&apos;SEARCH_PATH&apos;)
if (sp == null || sp.trim().isEmpty()) {
  def st = vars.get(&apos;SEARCH_TERM&apos;) ?: &apos;&apos;
  vars.put(&apos;SEARCH_PATH&apos;, st)
}
            </stringProp>
