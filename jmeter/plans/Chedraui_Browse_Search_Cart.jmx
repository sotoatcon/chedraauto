        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build persistedQuery variables (base64)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import groovy.json.JsonOutput
import java.util.Base64

def sku = (vars.get(&apos;SKU_1&apos;) ?: &apos;0&apos;) as Integer
def seller = vars.get(&apos;SELLER_1&apos;) ?: &apos;&apos;
def qty = (vars.get(&apos;QTY_1&apos;) ?: &apos;1&apos;) as Integer
def idx = (vars.get(&apos;ORDER_ITEM_INDEX&apos;) ?: &apos;0&apos;) as Integer
def qtyUpdate = (vars.get(&apos;QTY_1_UPDATE&apos;) ?: &apos;2&apos;) as Integer

def addVars = [items: [[id: sku, index: 0, quantity: qty, seller: seller, options: []]]]
def updVars = [orderItems: [[index: idx, quantity: qtyUpdate]], splitItem: false]

vars.put(&apos;ADD_TO_CART_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(addVars).getBytes(&apos;UTF-8&apos;)))
vars.put(&apos;UPDATE_ITEMS_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(updVars).getBytes(&apos;UTF-8&apos;)))
            </stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST GraphQL addToCart" enabled="true">
            <stringProp name="HTTPSampler.path">/_v/private/graphql/v1</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;addToCart&quot;,&quot;variables&quot;:{},&quot;extensions&quot;:{&quot;persistedQuery&quot;:{&quot;version&quot;:1,&quot;sha256Hash&quot;:&quot;a63161354718146c4282079551df81aaa8fa3d59584520cf5ea1c278fac0db33&quot;,&quot;sender&quot;:&quot;vtex.checkout-resources@0.x&quot;,&quot;provider&quot;:&quot;vtex.checkout-graphql@0.x&quot;},&quot;variables&quot;:&quot;${ADD_TO_CART_VARS_B64}&quot;}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
