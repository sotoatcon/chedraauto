          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build checkout payloads (clientProfile/shipping/simulation)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import groovy.json.JsonOutput

def orderFormId = vars.get(&apos;orderFormId&apos;) ?: &apos;&apos;
def addrId = vars.get(&apos;ADDRESS_ID&apos;) ?: &apos;ADDR1&apos;
def sku1 = (vars.get(&apos;SKU_1&apos;) ?: &apos;&apos;).toString()
def postal = vars.get(&apos;POSTAL_CODE&apos;) ?: &apos;&apos;
def city = vars.get(&apos;CITY&apos;) ?: &apos;&apos;
def state = vars.get(&apos;STATE&apos;) ?: &apos;&apos;
def country = vars.get(&apos;COUNTRY&apos;) ?: &apos;MEX&apos;
def street = vars.get(&apos;STREET&apos;) ?: &apos;&apos;
def number = vars.get(&apos;NUMBER&apos;) ?: &apos;&apos;
def neighborhood = vars.get(&apos;NEIGHBORHOOD&apos;) ?: &apos;&apos;
def complement = vars.get(&apos;COMPLEMENT&apos;) ?: &apos;&apos;
def receiverName = vars.get(&apos;RECEIVER_NAME&apos;)
def deliveryChannel = vars.get(&apos;DELIVERY_CHANNEL&apos;) ?: &apos;delivery&apos;
def slaId = vars.get(&apos;SLA_ID&apos;) ?: &apos;&apos;

def coordsStr = vars.get(&apos;GEO_COORDS&apos;) ?: &apos;&apos;
def parts = coordsStr.split(&apos;,&apos;)*.trim()
def lon = parts.size() &gt; 0 ? (parts[0] as Double) : 0.0
def lat = parts.size() &gt; 1 ? (parts[1] as Double) : 0.0

def address = [
  addressType: &apos;residential&apos;,
  receiverName: receiverName,
  addressId: addrId,
  isDisposable: true,
  postalCode: postal,
  city: city,
  state: state,
  country: country,
  street: street,
  number: number,
  neighborhood: neighborhood,
  complement: complement,
  reference: null,
  geoCoordinates: [lon, lat],
]

// Attachments/shippingData uses `selectedSla` and `itemId` (observed in HAR).
def logisticsInfoAttachment = [[
  addressId: addrId,
  itemId: sku1,
  itemIndex: 0,
  selectedSla: slaId,
  deliveryWindow: null,
]]

def shippingDataAttachment = [
  address: address,
  logisticsInfo: logisticsInfoAttachment,
  selectedAddresses: [address],
]

// simulation uses `selectedSLAId` and `selectedDeliveryChannel` (observed in HAR).
def logisticsInfoSimulation = [[
  addressId: addrId,
  itemIndex: 0,
  selectedDeliveryChannel: deliveryChannel,
  selectedSLAId: slaId,
]]

def clientProfile = [
  email: (vars.get(&apos;CLIENT_EMAIL&apos;) ?: &apos;&apos;),
  firstName: (vars.get(&apos;CLIENT_FIRST_NAME&apos;) ?: &apos;&apos;),
  lastName: (vars.get(&apos;CLIENT_LAST_NAME&apos;) ?: &apos;&apos;),
  document: null,
  documentType: null,
  phone: null,
]

def simulation = [
  shippingData: [
    logisticsInfo: logisticsInfoSimulation,
    selectedAddresses: [address],
  ],
  allowedOutdatedData: [&apos;paymentData&apos;],
  orderFormId: orderFormId,
]

vars.put(&apos;CLIENT_PROFILE_JSON&apos;, JsonOutput.toJson(clientProfile))
vars.put(&apos;SHIPPING_DATA_ATTACHMENT_JSON&apos;, JsonOutput.toJson(shippingDataAttachment))
vars.put(&apos;SIMULATION_JSON&apos;, JsonOutput.toJson(simulation))
            </stringProp>
          </JSR223PreProcessor>
