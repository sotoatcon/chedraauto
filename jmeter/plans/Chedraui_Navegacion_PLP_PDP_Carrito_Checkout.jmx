                  <stringProp name="Argument.value">{&quot;operationName&quot;:&quot;GetSimulationInfo&quot;,&quot;variables&quot;:{},&quot;extensions&quot;:{&quot;persistedQuery&quot;:{&quot;version&quot;:1,&quot;sha256Hash&quot;:&quot;a7111f6da28a2eef87f12b86613d2f30f11a27a96bded592986e7967daf24062&quot;,&quot;sender&quot;:&quot;chedrauimx.add-to-cart-button@1.x&quot;,&quot;provider&quot;:&quot;chedrauimx.products-simulator@0.x&quot;},&quot;variables&quot;:&quot;${SIM_INFO_VARS_B64}&quot;}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
