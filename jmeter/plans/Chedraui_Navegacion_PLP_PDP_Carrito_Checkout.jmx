        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build persistedQuery variables (base64)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import groovy.json.JsonOutput
import java.util.Base64

def sku = (vars.get(&apos;SKU_1&apos;) ?: &apos;0&apos;) as Integer
def seller = vars.get(&apos;SELLER_1&apos;) ?: &apos;&apos;
def qty = (vars.get(&apos;QTY_1&apos;) ?: &apos;1&apos;) as Integer
def idx = (vars.get(&apos;ORDER_ITEM_INDEX&apos;) ?: &apos;0&apos;) as Integer
def qtyUpdate = (vars.get(&apos;QTY_1_UPDATE&apos;) ?: &apos;2&apos;) as Integer

def addVars = [items: [[id: sku, index: 0, quantity: qty, seller: seller, options: []]]]
def updVars = [orderItems: [[index: idx, quantity: qtyUpdate]], splitItem: false]

vars.put(&apos;ADD_TO_CART_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(addVars).getBytes(&apos;UTF-8&apos;)))
vars.put(&apos;UPDATE_ITEMS_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(updVars).getBytes(&apos;UTF-8&apos;)))

def country = vars.get(&apos;COUNTRY&apos;) ?: &apos;MEX&apos;
def postal = vars.get(&apos;POSTAL_CODE&apos;) ?: &apos;&apos;
def addrType = vars.get(&apos;ADDRESS_TYPE&apos;) ?: &apos;search&apos;
def coordsStr = vars.get(&apos;GEO_COORDS&apos;) ?: &apos;0,0&apos;
def parts = coordsStr.split(&apos;,&apos;)*.trim()
def lon = parts.size() &gt; 0 ? (parts[0] as Double) : 0.0
def lat = parts.size() &gt; 1 ? (parts[1] as Double) : 0.0

def simVars = [item: [id: sku.toString(), quantity: 999, seller: seller, country: country, geoCoordinates: [lon, lat], postalCode: postal, addressType: addrType]]
vars.put(&apos;SIM_INFO_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(simVars).getBytes(&apos;UTF-8&apos;)))
            </stringProp>
          </JSR223PreProcessor>
          <hashTree/>
