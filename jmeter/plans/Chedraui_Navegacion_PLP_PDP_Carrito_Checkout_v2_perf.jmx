              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">
def start = (vars.get(&quot;T02_START_MS&quot;) ?: &quot;0&quot;) as long
def maxMs = (vars.get(&quot;MAX_02_MS&quot;) ?: &quot;3500&quot;) as long
def elapsed = System.currentTimeMillis() - start
if (start &gt; 0 &amp;&amp; elapsed &gt; maxMs) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;Block 02 exceeded: &quot; + elapsed + &quot;ms &gt; &quot; + maxMs + &quot;ms&quot;)
}
vars.remove(&quot;T02_START_MS&quot;)
