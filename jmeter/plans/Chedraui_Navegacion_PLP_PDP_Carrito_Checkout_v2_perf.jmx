            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Derive CART_ITEM_COUNT + FIRST_ITEM_ID + SLA_ID + SIMULATION_ITEMS_JSON" enabled="true">
