          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set SEARCH_PATH default from SEARCH_TERM" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
