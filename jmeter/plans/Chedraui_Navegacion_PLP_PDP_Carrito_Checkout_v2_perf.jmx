            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build checkout payloads (clientProfile/shipping/simulation)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters">               </stringProp>
              <stringProp name="filename">               </stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">
import groovy.json.JsonOutput
import groovy.json.JsonSlurper

def orderFormId = vars.get(&apos;orderFormId&apos;) ?: &apos;&apos;
def country = (vars.get(&apos;COUNTRY&apos;) ?: &apos;MEX&apos;).toString()
def defaultDeliveryChannel = (vars.get(&apos;DELIVERY_CHANNEL&apos;) ?: &apos;delivery&apos;).toString()
def defaultSlaId = (vars.get(&apos;SLA_ID&apos;) ?: &apos;&apos;).toString()

def itemsForCheckout = new JsonSlurper().parseText((vars.get(&apos;SIMULATION_ITEMS_JSON&apos;) ?: &apos;[]&apos;).toString())
if (!(itemsForCheckout instanceof List)) { itemsForCheckout = [] }
def itemCount = itemsForCheckout.size() &gt; 0 ? itemsForCheckout.size() : ((vars.get(&apos;CART_ITEM_COUNT&apos;) ?: &apos;1&apos;) as Integer)

def baseShippingDataJson = (vars.get(&apos;ORDERFORM_SHIPPINGDATA_JSON&apos;) ?: &apos;&apos;).toString().trim()
def baseShippingData = [:]
if (!baseShippingDataJson.isEmpty()) {
  try {
    def parsed = new JsonSlurper().parseText(baseShippingDataJson)
    if (parsed instanceof Map) { baseShippingData = parsed }
  } catch (Exception ignored) {
    baseShippingData = [:]
  }
}

def addressFromOrderForm = null
try { addressFromOrderForm = baseShippingData?.address } catch (Exception ignored) { addressFromOrderForm = null }
if (!(addressFromOrderForm instanceof Map)) {
  try {
    def sel = baseShippingData?.selectedAddresses
    if (sel instanceof List &amp;&amp; sel.size() &gt; 0 &amp;&amp; (sel[0] instanceof Map)) {
      addressFromOrderForm = sel[0]
    }
  } catch (Exception ignored) {
    addressFromOrderForm = null
  }
}

def addrId = &apos;&apos;
if (addressFromOrderForm instanceof Map) {
  addrId = (addressFromOrderForm?.addressId ?: &apos;&apos;).toString().trim()
}
if (addrId.isEmpty()) {
  addrId = (vars.get(&apos;ADDRESS_ID&apos;) ?: &apos;&apos;).toString().trim()
}
def isUuid = { String s -&gt;
  return (s ?: &apos;&apos;) ==~ /(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
}
if (!isUuid(addrId)) {
  addrId = java.util.UUID.randomUUID().toString()
}

def address = null
if (addressFromOrderForm instanceof Map) {
  address = new LinkedHashMap(addressFromOrderForm)
} else {
  def postal = (vars.get(&apos;POSTAL_CODE&apos;) ?: &apos;&apos;).toString()
  def city = (vars.get(&apos;CITY&apos;) ?: &apos;&apos;).toString()
  def state = (vars.get(&apos;STATE&apos;) ?: &apos;&apos;).toString()
  def street = (vars.get(&apos;STREET&apos;) ?: &apos;&apos;).toString()
  def number = (vars.get(&apos;NUMBER&apos;) ?: &apos;&apos;).toString()
  def neighborhood = (vars.get(&apos;NEIGHBORHOOD&apos;) ?: &apos;&apos;).toString()
  def complement = (vars.get(&apos;COMPLEMENT&apos;) ?: &apos;&apos;).toString()
  def receiverName = vars.get(&apos;RECEIVER_NAME&apos;)
  def addressType = (vars.get(&apos;ADDRESS_TYPE&apos;) ?: &apos;search&apos;).toString()

  def coordsStr = (vars.get(&apos;GEO_COORDS&apos;) ?: &apos;&apos;).toString()
  def parts = coordsStr.split(&apos;,&apos;)*.trim()
  def lon = parts.size() &gt; 0 ? (parts[0] as Double) : 0.0
  def lat = parts.size() &gt; 1 ? (parts[1] as Double) : 0.0

  address = [
    addressType: addressType,
    receiverName: receiverName,
    isDisposable: true,
    postalCode: postal,
    city: city,
    state: state,
    country: country,
    street: street,
    number: number,
    neighborhood: neighborhood,
    complement: complement,
    reference: null,
    geoCoordinates: [lon, lat],
  ]
}
address.addressId = addrId

def ofLi = null
try { ofLi = baseShippingData?.logisticsInfo } catch (Exception ignored) { ofLi = null }

def pickSlaForIndex = { int idx -&gt;
  def selectedSla = &apos;&apos;
  def selectedDc = &apos;&apos;

  if (ofLi instanceof List &amp;&amp; ofLi.size() &gt; idx) {
    def info = ofLi[idx]
    // Prefer the current selection from orderForm logisticsInfo.
    selectedSla = (info?.selectedSla ?: &apos;&apos;).toString()
    selectedDc = (info?.selectedDeliveryChannel ?: &apos;&apos;).toString()
    // Fallback to first SLA option when selection is missing.
    if (selectedSla.trim().isEmpty() || selectedDc.trim().isEmpty()) {
      def slas = info?.slas
      if (slas instanceof List &amp;&amp; slas.size() &gt; 0) {
        def s0 = slas[0]
        if (selectedSla.trim().isEmpty()) { selectedSla = (s0?.id ?: &apos;&apos;).toString() }
        if (selectedDc.trim().isEmpty()) { selectedDc = (s0?.deliveryChannel ?: &apos;&apos;).toString() }
      }
    }
  }

  if (selectedSla.trim().isEmpty()) { selectedSla = defaultSlaId }
  if (selectedDc.trim().isEmpty()) { selectedDc = defaultDeliveryChannel }

  return [sla: selectedSla, dc: selectedDc]
}

def logisticsInfoAttachment = []
def logisticsInfoSimulation = []
for (int i = 0; i &lt; itemCount; i++) {
  def sel = pickSlaForIndex(i)
  logisticsInfoAttachment &lt;&lt; [
    addressId: addrId,
    itemIndex: i,
    selectedSla: sel.sla,
    selectedDeliveryChannel: sel.dc,
    deliveryWindow: null,
  ]
  logisticsInfoSimulation &lt;&lt; [
    addressId: addrId,
    itemIndex: i,
    selectedDeliveryChannel: sel.dc,
    selectedSLAId: sel.sla,
  ]
}

// If we are forcing delivery, ensure the addressType is compatible.
def mainDc = &apos;&apos;
if (logisticsInfoAttachment.size() &gt; 0) {
  mainDc = (logisticsInfoAttachment[0]?.selectedDeliveryChannel ?: &apos;&apos;).toString()
}
if (mainDc.equalsIgnoreCase(&apos;delivery&apos;)) {
  address.addressType = &apos;residential&apos;
  def rn = (address.receiverName ?: &apos;&apos;).toString().trim()
  if (rn.isEmpty()) { address.receiverName = &apos;Test&apos; }
}

def shippingDataAttachment = (baseShippingData instanceof Map) ? new LinkedHashMap(baseShippingData) : [:]
shippingDataAttachment.clearAddressIfPostalCodeNotFound = false
shippingDataAttachment.address = address
shippingDataAttachment.selectedAddresses = [address]
if (!(shippingDataAttachment.availableAddresses instanceof List) || shippingDataAttachment.availableAddresses.size() == 0) { shippingDataAttachment.availableAddresses = [address] }
if (!(shippingDataAttachment.pickupPoints instanceof List)) { shippingDataAttachment.pickupPoints = [] }
if (shippingDataAttachment.contactInformation instanceof List) { shippingDataAttachment.remove(&apos;contactInformation&apos;) }
shippingDataAttachment.logisticsInfo = logisticsInfoAttachment

def clientProfile = [
  email: (vars.get(&apos;CLIENT_EMAIL&apos;) ?: &apos;&apos;),
  firstName: (vars.get(&apos;CLIENT_FIRST_NAME&apos;) ?: &apos;&apos;),
  lastName: (vars.get(&apos;CLIENT_LAST_NAME&apos;) ?: &apos;&apos;),
  document: null,
  documentType: null,
  phone: null,
]

def simulation = [
  items: itemsForCheckout,
  shippingData: [
    logisticsInfo: logisticsInfoSimulation,
    selectedAddresses: [address],
  ],
  country: country,
  allowedOutdatedData: [&apos;paymentData&apos;],
  orderFormId: orderFormId,
]

vars.put(&apos;CLIENT_PROFILE_JSON&apos;, JsonOutput.toJson(clientProfile))
vars.put(&apos;SHIPPING_DATA_ATTACHMENT_JSON&apos;, JsonOutput.toJson(shippingDataAttachment))
vars.put(&apos;SIMULATION_JSON&apos;, JsonOutput.toJson(simulation))

def enablePayment = (vars.get(&apos;ENABLE_PAYMENTDATA&apos;) ?: &apos;false&apos;).toString().toLowerCase() == &apos;true&apos;
def paymentSystem = (vars.get(&apos;PAYMENT_SYSTEM&apos;) ?: &apos;2&apos;).toString()
def installments = (vars.get(&apos;PAYMENT_INSTALLMENTS&apos;) ?: &apos;1&apos;) as Integer
def ofValue = (vars.get(&apos;ORDERFORM_VALUE&apos;) ?: &apos;0&apos;) as Long
def giftId = (vars.get(&apos;GIFTCARD_ID&apos;) ?: &apos;&apos;).toString().trim()
def giftProvider = (vars.get(&apos;GIFTCARD_PROVIDER&apos;) ?: &apos;&apos;).toString()

def payments = []
def giftCards = []
if (enablePayment) {
  payments = [[
    hasDefaultBillingAddress: false,
    isLuhnValid: null,
    installmentsInterestRate: 0,
    referenceValue: ofValue,
    bin: null,
    accountId: null,
    value: ofValue,
    tokenId: null,
    paymentSystem: paymentSystem,
    installments: installments,
    isRegexValid: null,
  ]]
  if (!giftId.isEmpty()) {
    giftCards = [[
      id: giftId,
      redemptionCode: null,
      value: 0,
      balance: 0,
      name: null,
      inUse: false,
      isSpecialCard: true,
      provider: giftProvider,
    ]]
  }
}

def paymentData = [
  payments: payments,
  giftCards: giftCards,
  expectedOrderFormSections: [&apos;items&apos;,&apos;totalizers&apos;,&apos;clientProfileData&apos;,&apos;shippingData&apos;,&apos;paymentData&apos;,&apos;sellers&apos;,&apos;messages&apos;,&apos;marketingData&apos;,&apos;clientPreferencesData&apos;,&apos;storePreferencesData&apos;,&apos;giftRegistryData&apos;,&apos;ratesAndBenefitsData&apos;,&apos;openTextField&apos;,&apos;commercialConditionData&apos;,&apos;customData&apos;],
]

vars.put(&apos;PAYMENT_DATA_JSON&apos;, JsonOutput.toJson(paymentData))
