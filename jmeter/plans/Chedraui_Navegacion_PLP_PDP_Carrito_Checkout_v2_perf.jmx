            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Derive CART_LAST_INDEX + SLA_ID + FIRST_ITEM_ID" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters">               </stringProp>
              <stringProp name="filename">               </stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
if (body == null || body.trim().isEmpty()) {
  return
}

def json = new JsonSlurper().parseText(body)
def items = (json.items instanceof List) ? json.items : []
def count = items.size()
vars.put(&apos;CART_ITEM_COUNT&apos;, String.valueOf(count))
def lastIndex = count &gt; 0 ? (count - 1) : 0
vars.put(&apos;CART_LAST_INDEX&apos;, String.valueOf(lastIndex))

def firstId = &apos;&apos;
if (count &gt; 0) {
  firstId = (items[0]?.id ?: &apos;&apos;).toString()
}
if (firstId == null || firstId.trim().isEmpty()) {
  firstId = (vars.get(&apos;SKU_1&apos;) ?: &apos;&apos;).toString()
}
vars.put(&apos;FIRST_ITEM_ID&apos;, firstId)

try {
  def li = json.shippingData?.logisticsInfo
  if (li instanceof List &amp;&amp; li.size() &gt; 0) {
    def selectedSla = (li[0]?.selectedSla ?: &apos;&apos;).toString()
    def selectedDc = (li[0]?.selectedDeliveryChannel ?: &apos;&apos;).toString()
    def slas = li[0]?.slas
    if (slas instanceof List &amp;&amp; slas.size() &gt; 0) {
      def sla = slas[0]
      def slaId = (sla?.id ?: &apos;&apos;).toString()
      def dc = (sla?.deliveryChannel ?: &apos;&apos;).toString()
      if (!slaId.isEmpty()) { vars.put(&apos;SLA_ID&apos;, slaId) }
      if (!dc.isEmpty()) { vars.put(&apos;DELIVERY_CHANNEL&apos;, dc) }
    } else {
      if (!selectedSla.isEmpty()) { vars.put(&apos;SLA_ID&apos;, selectedSla) }
      if (!selectedDc.isEmpty()) { vars.put(&apos;DELIVERY_CHANNEL&apos;, selectedDc) }
    }
  }
} catch (Exception ignored) {
}</stringProp>
            </JSR223PostProcessor>
