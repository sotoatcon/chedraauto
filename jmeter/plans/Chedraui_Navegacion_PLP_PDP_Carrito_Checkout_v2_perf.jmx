          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build session payload (api/sessions)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">             </stringProp>
            <stringProp name="filename">             </stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def profile = (vars.get(&apos;SESSION_PROFILE&apos;) ?: &apos;CASA&apos;).toString().trim()
def country = (vars.get(&apos;COUNTRY&apos;) ?: &apos;MEX&apos;).toString().trim()
def geoCasa = (vars.get(&apos;SESSION_GEO_CASA&apos;) ?: (vars.get(&apos;GEO_COORDS&apos;) ?: &apos;&apos;)).toString().trim()
def geoPolanco = (vars.get(&apos;SESSION_GEO_POLANCO&apos;) ?: geoCasa).toString().trim()
def regionPolanco = (vars.get(&apos;SESSION_REGION_POLANCO&apos;) ?: &apos;&apos;).toString().trim()
def regionVar = (vars.get(&apos;SESSION_REGION_ID&apos;) ?: &apos;&apos;).toString().trim()
def geoVar = (vars.get(&apos;GEO_COORDS&apos;) ?: &apos;&apos;).toString().trim()

def usePickup = profile.equalsIgnoreCase(&apos;POLANCO_PICKUP&apos;) || profile.equalsIgnoreCase(&apos;PICKUP_POLANCO&apos;) || profile.equalsIgnoreCase(&apos;PICKUP&apos;)
def regionId = usePickup ? (!regionVar.isEmpty() ? regionVar : regionPolanco) : null
def geo = !geoVar.isEmpty() ? geoVar : (usePickup ? geoPolanco : geoCasa)

vars.put(&apos;GEO_COORDS&apos;, geo)

def payload = [
  public: [
    country: [value: country],
    regionId: [value: regionId],
    geoCoordinates: [value: geo],
  ]
]

vars.put(&apos;SESSION_JSON&apos;, JsonOutput.toJson(payload))</stringProp>
