            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Category productSearchV3 vars (base64)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters">               </stringProp>
              <stringProp name="filename">               </stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import java.util.Base64

def query = (vars.get(&apos;CAT_QUERY&apos;) ?: &apos;&apos;).toString().trim()
def map = (vars.get(&apos;CAT_MAP&apos;) ?: &apos;&apos;).toString().trim()
def variant = (vars.get(&apos;SEG_VARIANT&apos;) ?: &apos;&apos;).toString()

def segs = query.isEmpty() ? [] : (query.split(&apos;/&apos;) as List)
def keys = map.isEmpty() ? [] : (map.split(&apos;,&apos;) as List)

def selectedFacets = []
def n = Math.min(segs.size(), keys.size())
for (int i = 0; i &lt; n; i++) {
  selectedFacets &lt;&lt; [key: keys[i], value: segs[i]]
}

def productSearchVars = [
  hideUnavailableItems: false,
  skusFilter: &apos;ALL&apos;,
  simulationBehavior: &apos;default&apos;,
  installmentCriteria: &apos;MAX_WITHOUT_INTEREST&apos;,
  productOriginVtex: false,
  map: map,
  query: query,
  orderBy: &apos;OrderByScoreDESC&apos;,
  from: 0,
  to: 19,
  selectedFacets: selectedFacets,
  facetsBehavior: &apos;Static&apos;,
  categoryTreeBehavior: &apos;default&apos;,
  withFacets: false,
  variant: variant,
]

vars.put(&apos;SEG_CAT_PRODUCTSEARCH_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(productSearchVars).getBytes(&apos;UTF-8&apos;)))</stringProp>
