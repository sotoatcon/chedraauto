              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PDP 01.2 - Build PDP path + slug" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters">                 </stringProp>
                <stringProp name="filename">                 </stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def link = (vars.get(&apos;PDP_LINK_FULL&apos;) ?: &apos;&apos;).toString().trim()
def slug = (vars.get(&apos;PDP_LINK_TEXT&apos;) ?: &apos;&apos;).toString().trim()

if (!slug.isEmpty()) {
  vars.put(&apos;PDP_SLUG&apos;, slug)
}

def pathOnly = &apos;&apos;
if (!link.isEmpty()) {
  try {
    def uri = new java.net.URI(link)
    def p = uri.getRawPath() ?: &apos;&apos;
    def q = uri.getRawQuery()
    pathOnly = q == null || q.isEmpty() ? p : (p + &apos;?&apos; + q)
  } catch (Exception ignored) {
    // Fallback: strip scheme/host if present
    def idx = link.indexOf(&apos;://&apos;)
    if (idx &gt; 0) {
      def tmp = link.substring(idx + 3)
      def slash = tmp.indexOf(&apos;/&apos;)
      pathOnly = slash &gt;= 0 ? tmp.substring(slash) : &apos;&apos;
    } else {
      pathOnly = link.startsWith(&apos;/&apos;) ? link : (&apos;/&apos; + link)
    }
  }
}
vars.put(&apos;PDP_PATH_DYNAMIC&apos;, pathOnly)</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
