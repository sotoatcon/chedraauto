            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert time (Block 03)" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters">               </stringProp>
              <stringProp name="filename">               </stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">
def start = (vars.get(&quot;T03_START_MS&quot;) ?: &quot;0&quot;) as long
def maxMs = (vars.get(&quot;MAX_03_MS&quot;) ?: &quot;7000&quot;) as long
def elapsed = System.currentTimeMillis() - start
if (start &gt; 0 &amp;&amp; elapsed &gt; maxMs) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;Block 03 exceeded: &quot; + elapsed + &quot;ms &gt; &quot; + maxMs + &quot;ms&quot;)
}
vars.remove(&quot;T03_START_MS&quot;)
              </stringProp>
            </JSR223Assertion>
