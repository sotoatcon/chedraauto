            <stringProp name="script">
import groovy.json.JsonOutput
import java.util.Base64

def slug = vars.get(&apos;PDP_SLUG&apos;) ?: &apos;&apos;
def id = (vars.get(&apos;PDP_IDENTIFIER_ID&apos;) ?: &apos;&apos;).toString()
def ids = (vars.get(&apos;PDP_PRODUCTS_BY_ID&apos;) ?: &apos;&apos;).toString()

def slugVars = [slug: slug, identifier: [field: &apos;id&apos;, value: id]]
def recoVars = [identifier: [field: &apos;id&apos;, value: id], type: &apos;view&apos;, groupBy: &apos;PRODUCT&apos;]
def byIdVars = [ids: ids]

vars.put(&apos;SEG_PDP_SLUG_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(slugVars).getBytes(&apos;UTF-8&apos;)))
vars.put(&apos;SEG_PDP_RECO_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(recoVars).getBytes(&apos;UTF-8&apos;)))
vars.put(&apos;SEG_PDP_BYID_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(byIdVars).getBytes(&apos;UTF-8&apos;)))
            </stringProp>
