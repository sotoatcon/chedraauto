def slug = (vars.get(&apos;PDP_SLUG&apos;) ?: &apos;&apos;).toString().trim()
def id = (vars.get(&apos;CART_SKU&apos;) ?: &apos;&apos;).toString().trim()

if (slug.isEmpty() || id.isEmpty()) {
  vars.put(&apos;SEG_PDP_SLUG_VARS_B64&apos;, &apos;&apos;)
  return
}

def slugVars = [slug: slug, identifier: [field: &apos;id&apos;, value: id]]
vars.put(&apos;SEG_PDP_SLUG_VARS_B64&apos;, Base64.encoder.encodeToString(JsonOutput.toJson(slugVars).getBytes(&apos;UTF-8&apos;)))</stringProp>
